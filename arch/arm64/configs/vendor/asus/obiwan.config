# Platform
CONFIG_MACH_ASUS_ZS661KS=y

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Audio
CONFIG_AUDIO_GM_CDEV=y

# Crypto
CONFIG_CRYPTO_LZ4=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
# CONFIG_MSM_QBT_HANDLER is not set

# FS
CONFIG_NLS_UTF8=y

# HID
CONFIG_HIDRAW=y
CONFIG_HID_STEAM=y
CONFIG_HID_LOGITECH=y
CONFIG_LOGITECH_FF=y

# Input
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_HALLSENSOR=y
CONFIG_INPUT_HALLSENSOR2=y

# LTO
CONFIG_LTO_CLANG=y

# Memory hotplug
# CONFIG_MEMORY_HOTPLUG is not set

# Net
CONFIG_SLA_STAIC_COLLECT=y

# Persistent store
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Power
CONFIG_ASUS_PD_CHARGER=y
CONFIG_CHARGER_PCA9468=y
CONFIG_USBPD_PHY_QCOM=y
CONFIG_DUAL_PD_PORT=y
CONFIG_ASUS_POWER_DEBUG=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"
CONFIG_CNSS_QCA6390=y

# Regulator
CONFIG_REGULATOR_PM8008=y

# Scheduler
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
# CONFIG_SCHED_TUNE is not set

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_UPDATE=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_GESTURE=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_TOOLS=y
CONFIG_TOUCHSCREEN_GOODIX_DRM_NOTIFY=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_STATION=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_UPDATE_STATION=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_SUPPORT=y
# CONFIG_TOUCHSCREEN_FTS is not set

# USB
CONFIG_USB_EC_DRIVER=y
CONFIG_USB_DP_SYNC=y
CONFIG_RT_REGMAP=y
CONFIG_DUAL_ROLE_USB_INTF=y
CONFIG_TCPC_CLASS=y
CONFIG_USB_POWER_DELIVERY=y
CONFIG_TCPC_RT1711H=y

# Vibrator
CONFIG_AW8697_HAPTIC=y
# CONFIG_TSPDRV_AW8697 is not set
# CONFIG_INPUT_QTI_HAPTICS is not set
